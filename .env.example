# School ERP Environment Configuration Example
# Copy to .env and configure appropriately

PORT=5000
NODE_ENV=development

# Database Configuration
DATABASE_PATH=./data/school_erp.sqlite

# Security & Secrets
JWT_SECRET=super-secure-change-in-production-secret-key-32chars
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10

# Multi-Tenancy
DEFAULT_SCHOOL_ID=1

# External Service Adapters (Set to 'mock' for local development & automated testing)
PAYMENT_GATEWAY_PROVIDER=mock
SMS_PROVIDER=mock
UDISE_EXPORT_ENABLED=true
